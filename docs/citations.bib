@inproceedings{Shao2025LLM-Empowered,
    title = "{LLM}-Empowered Patient-Provider Communication: A Data-Centric Survey From a Clinical Perspective",
    author = "Shao, Ruosi  and
      Seraj, Md Shamim  and
      Zhao, Kangyi  and
      Luo, Yingtao  and
      Li, Lincan  and
      Shen, Bolin  and
